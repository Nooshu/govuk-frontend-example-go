{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch example server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      },
      "preLaunchTask": "build-styles"
    },
    {
      "name": "Attach to process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": 0
    }
  ]
}
