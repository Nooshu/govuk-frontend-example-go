# Project npm policy — supply-chain hardening for Node tooling (Frontend pin, Sass, docs).
# Installs must not run lifecycle scripts; CI must use `npm ci` against the committed lockfile.

save-exact=true
package-lock=true
engine-strict=true
fund=false
update-notifier=false

# Block preinstall/install/postinstall from dependencies (common malware delivery path).
# This tree does not need native rebuilds; if a future dep does, rebuild it explicitly
# after review instead of turning scripts back on globally.
ignore-scripts=true

# Surface known advisories during install; CI also fails on high/critical via `npm run audit:npm`.
audit=true
audit-level=high
