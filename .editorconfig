# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{md,mdc,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{py,go}]
indent_size = 4

# Go html/template pages (embedded under internal/pages)
[*.gohtml]
indent_size = 2

[*.{cs,fs,vb}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{njk,html,css,scss}]
indent_size = 2
