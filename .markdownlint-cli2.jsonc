{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD041": false,
  },
  "globs": ["**/*.md", "**/*.mdc", "!node_modules/**", "!.git/**"],
  // Sibling rule sections, each with its own h1. Other Markdown files keep MD025.
  "overrides": [
    {
      "filter": [".cursor/rules/govuk-frontend-go.mdc"],
      "config": {
        "MD025": false,
      },
      "combine": "merge",
    },
  ],
}
